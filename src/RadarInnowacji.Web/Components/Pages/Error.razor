@page "/Error"
@using System.Diagnostics

<PageTitle>Błąd — Dziki gon do innowacji</PageTitle>

<div class="card dashboard-card">
    <div class="card-body">
        <h1 class="h4 text-danger">Wystąpił błąd</h1>
        <p>W trakcie przetwarzania żądania wystąpił nieoczekiwany błąd.</p>

        @if (ShowRequestId)
        {
            <p>
                <strong>Identyfikator żądania:</strong> <code>@RequestId</code>
            </p>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
