@page "/kategorie"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@inject ICategoryService CategoryService
@inject ICategorizationService CategorizationService
@inject ITrendService TrendService
@inject IOptions<RadarOptions> Options

<PageTitle>Kategorie i trendy — Dziki gon do innowacji</PageTitle>

<div class="page-header">
    <div>
        <h1>Kategorie i trendy</h1>
        <p class="page-subtitle">Grupy tematyczne wykryte na podstawie podobieństwa projektów.</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <span class="badge bg-light text-dark border">Embeddingi: @Options.Value.Categories.EmbeddingProvider</span>
        <button type="button" class="btn btn-sm btn-primary" disabled="@analizuje" @onclick="PrzeliczAsync">
            @(analizuje ? "Grupowanie…" : "Przelicz kategorie")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(komunikat))
{
    <div class="alert @(komunikatBlad ? "alert-warning" : "alert-success") py-2 small">@komunikat</div>
}

<div class="row g-3">
    <div class="col-12 col-xl-7">
        <div class="card dashboard-card h-100">
            <div class="card-header dashboard-card-header">Kategorie (@kategorie.Count)</div>
            <div class="card-body">
                @if (kategorie.Count == 0)
                {
                    <div class="empty-panel">Brak kategorii. Kategorie zostaną wykryte na podstawie podobieństwa projektów.</div>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Nazwa</th><th>Projekty</th></tr></thead>
                        <tbody>
                            @foreach (var category in kategorie)
                            {
                                <tr>
                                    <td>@category.Name</td>
                                    <td><span class="badge bg-primary">@category.Count</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="card dashboard-card h-100">
            <div class="card-header dashboard-card-header">Trendy · @trendy.PeriodLabel</div>
            <div class="card-body">
                @if (trendy.Categories.Count == 0)
                {
                    <div class="empty-panel">
                        Brak kategorii z projektami w analizowanym okresie. Trendy pojawią się po przypisaniu
                        projektów do kategorii.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <span class="badge bg-primary">Nowe projekty: @trendy.TotalNewProjects</span>
                        <span class="badge bg-light text-dark border">Kategorie: @trendy.Categories.Count</span>
                        <span class="badge bg-light text-dark border">@trendy.MonitoredSources źródeł</span>
                        <span class="badge bg-light text-dark border">Skan co @trendy.ScanIntervalMinutes min</span>
                    </div>

                    var months = trendy.Points.Select(x => x.Period).Distinct().OrderBy(x => x).ToList();
                    var top = trendy.MostActive.Take(5).ToList();
                    var maxValue = Math.Max(1, trendy.Points.Count == 0 ? 1 : trendy.Points.Max(x => x.NewProjects));
                    @if (months.Count > 1 && top.Count > 0)
                    {
                        <svg viewBox="0 0 560 190" role="img" aria-label="Wykres liczby nowych projektów w kategoriach"
                             style="width:100%;height:auto;max-height:210px">
                            @for (var line = 0; line <= 3; line++)
                            {
                                var y = 20 + line * 45;
                                <line x1="40" y1="@y" x2="550" y2="@y" stroke="#e9ecef" stroke-width="1" />
                                @Tekst(34, y + 4, (maxValue - line * maxValue / 3).ToString(CultureInfo.InvariantCulture), "end", "9")
                            }
                            @for (var index = 0; index < months.Count; index++)
                            {
                                var x = XPozycja(index, months.Count);
                                @Tekst(x, 185, months[index], "middle", "9")
                            }
                            @for (var categoryIndex = 0; categoryIndex < top.Count; categoryIndex++)
                            {
                                var category = top[categoryIndex];
                                <polyline fill="none" stroke="@Kolor(categoryIndex)" stroke-width="2.5"
                                          points="@Punkty(category.CategoryId, months, maxValue)" />
                            }
                        </svg>
                        <div class="d-flex flex-wrap gap-2 mb-3 small">
                            @for (var categoryIndex = 0; categoryIndex < top.Count; categoryIndex++)
                            {
                                <span><span class="kolor-kwadrat" style="background:@Kolor(categoryIndex)"></span>@top[categoryIndex].Name</span>
                            }
                        </div>
                    }

                    <h2 class="h6">Najaktywniejsze kategorie</h2>
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Kategoria</th><th>Teraz</th><th>Poprzednio</th><th>Dynamika</th></tr></thead>
                        <tbody>
                            @foreach (var summary in trendy.MostActive)
                            {
                                <tr>
                                    <td>@summary.Name</td>
                                    <td>@summary.CurrentCount</td>
                                    <td>@summary.PreviousCount</td>
                                    <td>@Dynamika(summary)</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <h2 class="h6">Najszybciej rosnące</h2>
                    @if (trendy.FastestGrowing.Count == 0)
                    {
                        <p class="small text-muted mb-2">Brak kategorii z porównywalnym poprzednim okresem.</p>
                    }
                    else
                    {
                        <p class="small mb-2">@string.Join(", ", trendy.FastestGrowing.Select(x => $"{x.Name} ({x.GrowthPercent:0.0}%)"))</p>
                    }

                    <h2 class="h6">Nowe kategorie</h2>
                    <p class="small mb-2">
                        @if (trendy.NewCategories.Count == 0)
                        {
                            <span class="text-muted">Brak nowych kategorii w tym okresie.</span>
                        }
                        else
                        {
                            @string.Join(", ", trendy.NewCategories.Select(x => x.Name))
                        }
                    </p>

                    <ul class="small text-muted mb-0">
                        @foreach (var note in trendy.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="card dashboard-card mt-3">
    <div class="card-header dashboard-card-header">Propozycje nowych kategorii (@propozycje.Count)</div>
    <div class="card-body">
        <p class="small text-muted">
            Propozycje powstają z grup podobnych projektów. Nie są faktem ani potwierdzoną kategorią –
            kategoria jest tworzona dopiero po akceptacji. Odrzuconych propozycji nie powtarzamy.
        </p>
        @if (propozycje.Count == 0)
        {
            <div class="empty-panel">Brak propozycji. Uruchom grupowanie lub dodaj więcej podobnych projektów.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr><th>Propozycja</th><th>Projekty</th><th>Podobieństwo</th><th>Data</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var proposal in propozycje)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@proposal.Name</span>
                                    <div class="small text-muted">@proposal.Description</div>
                                    <div class="small text-muted">Słowa kluczowe: @string.Join(", ", proposal.Keywords)</div>
                                </td>
                                <td>
                                    <span class="small">@string.Join(", ", proposal.Projects.Take(4))</span>
                                    @if (proposal.Projects.Count > 4)
                                    {
                                        <span class="small text-muted"> i jeszcze @(proposal.Projects.Count - 4)</span>
                                    }
                                </td>
                                <td><span class="badge bg-info text-dark">@proposal.Similarity.ToString("0.00")</span></td>
                                <td><span class="small">@UiLabels.DataCzas(proposal.CreatedAt)</span></td>
                                <td><span class="badge @BadgePropozycji(proposal.Status)">@EtykietaPropozycji(proposal.Status)</span></td>
                                <td>
                                    @if (proposal.Status == CategoryProposalStatus.Pending)
                                    {
                                        <div class="d-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-success"
                                                    @onclick="() => ZatwierdzAsync(proposal.Id)">Akceptuj</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => OdrzucAsync(proposal.Id)">Odrzuć</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card dashboard-card mt-3">
    <div class="card-header dashboard-card-header">Grupy podobnych projektów (@grupy.Count)</div>
    <div class="card-body">
        @if (grupy.Count == 0)
        {
            <div class="empty-panel">Brak grup. Grupy powstają podczas cyklicznego grupowania projektów.</div>
        }
        else
        {
            @foreach (var group in grupy)
            {
                <div class="mb-3">
                    <div class="small fw-semibold">Grupa @group.Id · @group.ProjectCount projektów · podobieństwo @group.AverageSimilarity.ToString("0.00")</div>
                    <ul class="small mb-0">
                        @foreach (var project in group.Projects)
                        {
                            <li>
                                @if (project.DiscoveryId is { } discoveryId)
                                {
                                    <a href="/odkrycia/@discoveryId">@project.Title</a>
                                }
                                else
                                {
                                    <span>@project.Title</span>
                                }
                                <span class="text-muted">· świeżość @project.FreshnessScore.ToString("0.0")%</span>
                                @if (project.Categories.Count > 0)
                                {
                                    <span class="text-muted">· @string.Join(", ", project.Categories)</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12 col-xl-6">
        <div class="card dashboard-card h-100">
            <div class="card-header dashboard-card-header">Aktywność w czasie (ostatnie @aktywnosc.Count dni)</div>
            <div class="card-body">
                @{
                    var maxProjekty = Math.Max(1, aktywnosc.Count == 0 ? 1 : aktywnosc.Max(x => x.NewProjects));
                    var maxOdkrycia = Math.Max(1, aktywnosc.Count == 0 ? 1 : aktywnosc.Max(x => x.NewDiscoveries));
                    var krok = aktywnosc.Count <= 1 ? 560 : 540.0 / (aktywnosc.Count - 1);
                }
                @if (aktywnosc.Count == 0)
                {
                    <div class="empty-panel">Brak danych aktywności.</div>
                }
                else
                {
                    <svg viewBox="0 0 560 180" role="img" aria-label="Wykres aktywności projektów i odkryć"
                         style="width:100%;height:auto;max-height:200px">
                        <line x1="40" y1="150" x2="550" y2="150" stroke="#dee2e6" />
                        @for (var index = 0; index < aktywnosc.Count; index++)
                        {
                            var point = aktywnosc[index];
                            var x = 45 + index * krok;
                            var height = 120.0 * point.NewProjects / maxProjekty;
                            <rect x="@x.ToString("0.0", CultureInfo.InvariantCulture)"
                                  y="@((150 - height).ToString("0.0", CultureInfo.InvariantCulture))"
                                  width="@Math.Max(2, krok - 2).ToString("0.0", CultureInfo.InvariantCulture)"
                                  height="@height.ToString("0.0", CultureInfo.InvariantCulture)"
                                  fill="#0d6efd" opacity="0.65" />
                        }
                        <polyline fill="none" stroke="#fd7e14" stroke-width="2"
                                  points="@PunktyAktywnosci(maxOdkrycia)" />
                        @Tekst(45, 170, aktywnosc.First().Date, "start", "9")
                        @Tekst(550, 170, aktywnosc.Last().Date, "end", "9")
                    </svg>
                    <div class="small text-muted">
                        <span class="kolor-kwadrat" style="background:#0d6efd"></span>nowe projekty ·
                        <span class="kolor-kwadrat" style="background:#fd7e14"></span>nowe odkrycia (materiały)
                    </div>
                    <p class="small text-muted mt-2 mb-0">
                        Liczba nowych odkryć zależy od monitorowanych źródeł i częstotliwości skanowania
                        i nie jest miarą rzeczywistej innowacyjności.
                    </p>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-6">
        <div class="card dashboard-card h-100">
            <div class="card-header dashboard-card-header">Porównanie kategorii</div>
            <div class="card-body table-responsive">
                @if (porownanie.Count == 0)
                {
                    <div class="empty-panel">Brak kategorii do porównania.</div>
                }
                else
                {
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr><th>Kategoria</th><th>Projekty</th><th>Odkrycia</th><th>Źródła</th><th>Nowe</th><th>Świeżość</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in porownanie)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.ProjectCount</td>
                                    <td>@item.DiscoveryCount</td>
                                    <td>@item.SourceCount</td>
                                    <td>@item.NewProjectsLastPeriod</td>
                                    <td>@item.AverageFreshness.ToString("0.0")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="card dashboard-card mt-3">
    <div class="card-header dashboard-card-header">Historia kategorii (@historia.Count)</div>
    <div class="card-body">
        @if (historia.Count == 0)
        {
            <div class="empty-panel">Brak zmian w katalogu kategorii.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>Data</th><th>Zmiana</th><th>Kategoria</th><th>Szczegóły</th><th>Źródło</th></tr></thead>
                    <tbody>
                        @foreach (var entry in historia)
                        {
                            <tr>
                                <td><span class="small">@UiLabels.DataCzas(entry.ChangedAt)</span></td>
                                <td><span class="small fw-semibold">@entry.Change</span></td>
                                <td><span class="small">@entry.CategoryName</span></td>
                                <td><span class="small text-muted">@entry.Details</span></td>
                                <td><span class="small">@entry.Actor</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<CategoryCount> kategorie = Array.Empty<CategoryCount>();
    private IReadOnlyList<CategoryProposalModel> propozycje = Array.Empty<CategoryProposalModel>();
    private IReadOnlyList<ProjectCluster> grupy = Array.Empty<ProjectCluster>();
    private IReadOnlyList<CategoryHistoryItem> historia = Array.Empty<CategoryHistoryItem>();
    private TrendAnalysisModel trendy = new();
    private IReadOnlyList<ProjectActivityPoint> aktywnosc = Array.Empty<ProjectActivityPoint>();
    private IReadOnlyList<CategoryComparison> porownanie = Array.Empty<CategoryComparison>();
    private string komunikat = string.Empty;
    private bool komunikatBlad;
    private bool analizuje;

    protected override async Task OnInitializedAsync()
    {
        await OdswiezAsync();
    }

    private async Task OdswiezAsync()
    {
        kategorie = await CategoryService.GetAllWithCountsAsync();
        propozycje = await CategorizationService.GetProposalsAsync();
        grupy = await CategorizationService.GetClustersAsync();
        historia = await CategorizationService.GetHistoryAsync();
        var miesiace = Math.Clamp(Options.Value.Projects.TrendMonths, 1, 24);
        trendy = await TrendService.GetTrendsAsync(miesiace);
        porownanie = await TrendService.GetCategoryComparisonAsync(miesiace);
        aktywnosc = await TrendService.GetActivityAsync(30);
    }

    private async Task PrzeliczAsync()
    {
        analizuje = true;
        komunikat = string.Empty;
        try
        {
            var result = await CategorizationService.AnalyzeAsync();
            komunikat = result.Message;
            komunikatBlad = false;
            await OdswiezAsync();
        }
        catch (Exception exception)
        {
            komunikat = $"Grupowanie nie powiodło się: {exception.Message}";
            komunikatBlad = true;
        }
        finally
        {
            analizuje = false;
        }
    }

    private async Task ZatwierdzAsync(int id)
    {
        var accepted = await CategorizationService.AcceptProposalAsync(id);
        komunikat = accepted ? "Zaakceptowano propozycję i przypisano projekty do kategorii." : "Nie znaleziono oczekującej propozycji.";
        komunikatBlad = !accepted;
        await OdswiezAsync();
    }

    private async Task OdrzucAsync(int id)
    {
        var rejected = await CategorizationService.RejectProposalAsync(id);
        komunikat = rejected ? "Odrzucono propozycję. Nie będzie ona powtarzana." : "Nie znaleziono oczekującej propozycji.";
        komunikatBlad = !rejected;
        await OdswiezAsync();
    }

    private static readonly string[] Paleta = ["#0d6efd", "#198754", "#fd7e14", "#6f42c1", "#dc3545"];

    private static string Kolor(int index) => Paleta[index % Paleta.Length];

    private static MarkupString Tekst(
        double x,
        double y,
        string content,
        string anchor = "middle",
        string size = "10",
        string weight = "400",
        string color = "#495057") =>
        new($"<text x=\"{x.ToString("0.0", CultureInfo.InvariantCulture)}\" " +
            $"y=\"{y.ToString("0.0", CultureInfo.InvariantCulture)}\" " +
            $"text-anchor=\"{anchor}\" font-size=\"{size}\" font-weight=\"{weight}\" fill=\"{color}\">" +
            $"{System.Net.WebUtility.HtmlEncode(content)}</text>");

    private static double XPozycja(int index, int count) =>
        count <= 1 ? 295 : 45 + index * (500.0 / (count - 1));

    private static double YPozycja(int value, int max) => 155 - 130.0 * value / Math.Max(1, max);

    private string Punkty(int categoryId, IReadOnlyList<string> months, int max)
    {
        var byMonth = trendy.Points
            .Where(x => x.CategoryId == categoryId)
            .ToDictionary(x => x.Period, x => x.NewProjects);
        return string.Join(" ", months.Select((month, index) =>
            $"{XPozycja(index, months.Count).ToString("0.0", CultureInfo.InvariantCulture)}," +
            $"{YPozycja(byMonth.GetValueOrDefault(month), max).ToString("0.0", CultureInfo.InvariantCulture)}"));
    }

    private string PunktyAktywnosci(int max)
    {
        if (aktywnosc.Count == 0)
        {
            return string.Empty;
        }

        var step = aktywnosc.Count <= 1 ? 0 : 500.0 / (aktywnosc.Count - 1);
        return string.Join(" ", aktywnosc.Select((point, index) =>
            $"{(45 + index * step).ToString("0.0", CultureInfo.InvariantCulture)}," +
            $"{(150 - 120.0 * point.NewDiscoveries / Math.Max(1, max)).ToString("0.0", CultureInfo.InvariantCulture)}"));
    }

    private static string Dynamika(CategoryTrendSummary summary)
    {
        if (summary.GrowthPercent is null)
        {
            return summary.CurrentCount > 0 ? "nowa" : "brak danych";
        }

        var value = summary.GrowthPercent.Value;
        return $"{(value > 0 ? "+" : string.Empty)}{value.ToString("0.0", CultureInfo.InvariantCulture)}%";
    }

    private static string BadgePropozycji(CategoryProposalStatus status) => status switch
    {
        CategoryProposalStatus.Pending => "bg-warning text-dark",
        CategoryProposalStatus.Accepted => "bg-success",
        _ => "bg-secondary"
    };

    private static string EtykietaPropozycji(CategoryProposalStatus status) => status switch
    {
        CategoryProposalStatus.Pending => "Oczekuje na decyzję",
        CategoryProposalStatus.Accepted => "Zaakceptowana",
        _ => "Odrzucona"
    };
}
