@page "/ustawienia"
@rendermode InteractiveServer
@inject IOptions<RadarOptions> Options
@inject IAiAnalysisService AiService

<PageTitle>Ustawienia — Radar Innowacji</PageTitle>

<div class="page-header">
    <div>
        <h1>Ustawienia</h1>
        <p class="page-subtitle">Parametry uruchomienia aplikacji.</p>
    </div>
</div>

<div class="card dashboard-card">
    <div class="card-header dashboard-card-header">Konfiguracja lokalna</div>
    <div class="card-body">
        <dl class="row mb-0 small">
            <dt class="col-sm-4">Port nasłuchiwania</dt><dd class="col-sm-8">@Options.Value.Port (tylko 127.0.0.1)</dd>
            <dt class="col-sm-4">Otwieranie przeglądarki</dt><dd class="col-sm-8">@(Options.Value.OpenBrowser ? "Włączone" : "Wyłączone")</dd>
            <dt class="col-sm-4">Blokada drugiej instancji</dt><dd class="col-sm-8">@(Options.Value.SingleInstance ? "Włączona" : "Wyłączona")</dd>
            <dt class="col-sm-4">Baza danych</dt><dd class="col-sm-8"><code>@Options.Value.EffectiveDatabasePath</code></dd>
            <dt class="col-sm-4">Logi</dt><dd class="col-sm-8"><code>@Options.Value.EffectiveLogDirectory</code></dd>
        </dl>
        <hr />
        <p class="small text-muted mb-0">
            Ustawienia znajdują się w pliku <code>appsettings.json</code> oraz w zmiennych środowiskowych
            <code>RADAR_*</code>. Dane użytkownika są przechowywane poza katalogiem instalacyjnym.
        </p>
    </div>
</div>

<div class="card dashboard-card mt-3">
    <div class="card-header dashboard-card-header">Analiza AI (Ollama)</div>
    <div class="card-body">
        <dl class="row mb-3 small">
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Options.Value.Ai.Enabled ? "Włączona" : "Wyłączona")</dd>
            <dt class="col-sm-4">Model</dt><dd class="col-sm-8"><code>@Options.Value.Ai.Model</code></dd>
            <dt class="col-sm-4">Adres Ollamy</dt><dd class="col-sm-8"><code>@Options.Value.Ai.BaseUrl</code></dd>
            <dt class="col-sm-4">Interwał kolejki</dt><dd class="col-sm-8">@Options.Value.Ai.IntervalMinutes min (partia: @Options.Value.Ai.BatchSize)</dd>
        </dl>
        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@testowanie"
                @onclick="TestPolaczeniaAsync">@(testowanie ? "Sprawdzanie…" : "Test połączenia")</button>
        @if (!string.IsNullOrEmpty(komunikat))
        {
            <div class="alert @(komunikatBlad ? "alert-warning" : "alert-success") py-2 small mt-3 mb-0">@komunikat</div>
        }
        <p class="small text-muted mb-0 mt-3">
            AI jest opcjonalne. Bez Ollamy aplikacja nadal pobiera materiały i oznacza je jako oczekujące na analizę.
        </p>
    </div>
</div>

<div class="card dashboard-card mt-3">
    <div class="card-header dashboard-card-header">Kategorie i świeżość</div>
    <div class="card-body">
        <dl class="row mb-0 small">
            <dt class="col-sm-4">Grupowanie projektów</dt>
            <dd class="col-sm-8">@(Options.Value.Categories.Enabled ? "Włączone" : "Wyłączone")</dd>
            <dt class="col-sm-4">Dostawca embeddingów</dt><dd class="col-sm-8"><code>@Options.Value.Categories.EmbeddingProvider</code></dd>
            <dt class="col-sm-4">Model embeddingowy (Ollama)</dt><dd class="col-sm-8"><code>@Options.Value.Categories.OllamaEmbeddingModel</code></dd>
            <dt class="col-sm-4">Próg podobieństwa projektów</dt><dd class="col-sm-8">@Options.Value.Categories.MinSimilarity.ToString("0.00")</dd>
            <dt class="col-sm-4">Interwał grupowania</dt><dd class="col-sm-8">@Options.Value.Categories.IntervalMinutes min</dd>
        </dl>
        <p class="small text-muted mb-0 mt-3">
            Domyślny dostawca „Lokalny” nie wymaga Ollamy. Zmiana na „Ollama” wymaga zainstalowania
            modelu embeddingowego; w przeciwnym razie cykl grupowania zakończy się ostrzeżeniem w logu.
        </p>
    </div>
</div>

@code {
    private string komunikat = string.Empty;
    private bool komunikatBlad;
    private bool testowanie;

    private async Task TestPolaczeniaAsync()
    {
        testowanie = true;
        komunikat = string.Empty;
        try
        {
            var wynik = await AiService.TestConnectionAsync();
            komunikat = wynik.Message;
            komunikatBlad = !wynik.IsAvailable;
        }
        catch (Exception exception)
        {
            komunikat = $"Nie można sprawdzić połączenia: {exception.Message}";
            komunikatBlad = true;
        }
        finally
        {
            testowanie = false;
        }
    }
}
