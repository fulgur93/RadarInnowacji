@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="app-sidebar">
        <div class="sidebar-brand">
            <img class="brand-mark" src="dzik.svg" alt="" aria-hidden="true" />
            <div>
                <strong>DZIKI GON<br />DO INNOWACJI</strong>
                <small>System wykrywania innowacji</small>
            </div>
        </div>
        <NavMenu />
        <ShutdownButton @rendermode="InteractiveServer" />
        <div class="sidebar-footer">Wersja 1.0 · prototyp hackathonowy</div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <span class="topbar-title">Panel analityczny</span>
            <span class="topbar-badge">Dane demonstracyjne można załadować jednym kliknięciem</span>
        </header>
        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss" aria-hidden="true">×</span>
</div>
