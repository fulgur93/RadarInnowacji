<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RadarInnowacji.Core\RadarInnowacji.Core.csproj" />
    <ProjectReference Include="..\RadarInnowacji.Infrastructure\RadarInnowacji.Infrastructure.csproj" />
    <ProjectReference Include="..\RadarInnowacji.Worker\RadarInnowacji.Worker.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <ApplicationIcon>radar.ico</ApplicationIcon>
    <Product>Radar Innowacji</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Publikacja dla instalatora: dotnet publish -c Release -r win-x64 (zob. installer/). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
